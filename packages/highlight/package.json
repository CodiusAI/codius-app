{
  "name": "@codius.ai/highlight",
  "version": "0.3.0",
  "description": "Syntax-highlighting utilities used by Codius",
  "keywords": [
    "codemirror",
    "codius",
    "syntax-highlighting"
  ],
  "homepage": "https://codius.ai",
  "bugs": {
    "url": "https://github.com/CodiusAI/codius-app/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Prismosoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodiusAI/codius-app.git",
    "directory": "packages/highlight"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@lezer/common": "^1.5.0",
    "@lezer/cpp": "^1.1.5",
    "@lezer/css": "^1.3.0",
    "@lezer/go": "^1.0.1",
    "@lezer/highlight": "^1.2.3",
    "@lezer/html": "^1.3.13",
    "@lezer/java": "^1.1.3",
    "@lezer/javascript": "^1.5.4",
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.6.2",
    "@lezer/php": "^1.0.5",
    "@lezer/python": "^1.1.18",
    "@lezer/rust": "^1.0.2",
    "@lezer/xml": "^1.0.6",
    "@lezer/yaml": "^1.0.4",
    "@replit/codemirror-lang-csharp": "^6.2.0",
    "lezer-elixir": "^1.1.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
