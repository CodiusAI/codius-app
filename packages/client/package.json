{
  "name": "@codius.ai/client",
  "version": "0.2.0-beta.6",
  "description": "Codius client SDK package",
  "keywords": [
    "coding-agents",
    "codius",
    "sdk"
  ],
  "homepage": "https://codius.ai/docs",
  "bugs": {
    "url": "https://github.com/CodiusAI/codius-app/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Prismosoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodiusAI/codius-app.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal/daemon-client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./internal/daemon-client-transport-types": {
      "types": "./dist/daemon-client-transport-types.d.ts",
      "default": "./dist/daemon-client-transport-types.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build --workspace=@codius.ai/relay && npm run build --workspace=@codius.ai/protocol && tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "typecheck:examples": "tsgo -p tsconfig.examples.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codius.ai/protocol": "0.2.0-beta.6",
    "@codius.ai/relay": "0.2.0-beta.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
