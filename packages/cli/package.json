{
  "name": "@codius.ai/cli",
  "version": "0.3.3",
  "description": "Codius CLI - control coding agents, workspaces, and Codius hosts",
  "keywords": [
    "cli",
    "coding-agents",
    "codius",
    "worktrees"
  ],
  "homepage": "https://codius.ai",
  "bugs": {
    "url": "https://github.com/CodiusAI/codius-app/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Prismosoft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodiusAI/codius-app.git",
    "directory": "packages/cli"
  },
  "bin": {
    "codius": "bin/codius"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test": "npm run test:local",
    "test:local": "node tests/run-all.mjs",
    "test:e2e": "npm run test:local",
    "test:e2e:lifecycle": "npx tsx tests/e2e/agent-lifecycle.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@codius.ai/client": "0.3.3",
    "@codius.ai/protocol": "0.3.3",
    "@codius.ai/server": "0.3.3",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "tree-kill": "^1.2.2",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
