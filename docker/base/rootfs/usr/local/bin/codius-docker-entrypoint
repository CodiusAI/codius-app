#!/usr/bin/env bash
set -euo pipefail

IMAGE_HOME="/home/codius"

: "${HOME:=$IMAGE_HOME}"
: "${CODIUS_HOME:=${HOME}/.codius}"
: "${CODIUS_LISTEN:=0.0.0.0:6767}"
: "${CODIUS_WEB_UI_ENABLED:=true}"
: "${CODIUS_LOG_LEVEL:=info}"
: "${CODIUS_LOG_FORMAT:=json}"
: "${CLAUDE_CONFIG_DIR:=${HOME}/.claude}"
: "${CODEX_HOME:=${HOME}/.codex}"
: "${XDG_CONFIG_HOME:=${HOME}/.config}"
: "${XDG_DATA_HOME:=${HOME}/.local/share}"
: "${XDG_STATE_HOME:=${HOME}/.local/state}"
: "${XDG_CACHE_HOME:=${HOME}/.cache}"

export HOME
export CODIUS_HOME
export CODIUS_LISTEN
export CODIUS_WEB_UI_ENABLED
export CODIUS_LOG_LEVEL
export CODIUS_LOG_FORMAT
export CLAUDE_CONFIG_DIR
export CODEX_HOME
export XDG_CONFIG_HOME
export XDG_DATA_HOME
export XDG_STATE_HOME
export XDG_CACHE_HOME

ensure_dir() {
  local dir="$1"
  mkdir -p "$dir"
  if [[ "$(id -u)" == "0" ]]; then
    local owner
    owner="$(stat -c "%u" "$dir")"
    if [[ "$owner" == "0" ]]; then
      chown codius:codius "$dir"
    fi
  fi
}

ensure_dir "$HOME"
ensure_dir "$CODIUS_HOME"
ensure_dir "$CLAUDE_CONFIG_DIR"
ensure_dir "$CODEX_HOME"
ensure_dir "$XDG_CONFIG_HOME"
ensure_dir "$XDG_DATA_HOME"
ensure_dir "$XDG_STATE_HOME"
ensure_dir "$XDG_CACHE_HOME"

if [[ "$#" -gt 0 ]]; then
  if [[ "$(id -u)" == "0" ]]; then
    exec gosu codius "$@"
  fi
  exec "$@"
fi

if [[ -z "${CODIUS_PASSWORD:-}" ]]; then
  {
    echo "[codius] WARNING: CODIUS_PASSWORD is not set."
    echo "[codius] The daemon accepts unauthenticated control connections from any client that can reach it."
    echo "[codius] Set CODIUS_PASSWORD for any published port or network-reachable deployment."
  } >&2
fi

if [[ ! -f /etc/codius-server-entry ]]; then
  echo "[codius] FATAL: /etc/codius-server-entry is missing." >&2
  exit 1
fi

entry="$(cat /etc/codius-server-entry)"
echo "[codius] starting daemon on ${CODIUS_LISTEN} with web UI ${CODIUS_WEB_UI_ENABLED}"
if [[ "$(id -u)" == "0" ]]; then
  exec gosu codius node "$entry"
fi
exec node "$entry"
